# Python
__pycache__/
*.py[cod]
.pytest_cache/
.testmondata

# Virtual environment (recreate with `uv sync`)
.venv/

# PyCharm / JetBrains (machine-specific settings)
.idea/

# macOS
.DS_Store

# Run logs (capture benchmarks, debug sessions)
logs/

# Landmark recordings of the player (personal data; fixtures are copied explicitly)
recordings/

# Song library: only the catalog is tracked. Fetched CC BY demo tracks
# (uv run parapara-fetch-demo-songs) stay local.
assets/songs/*
!assets/songs/catalog.json

# Song candidate search results / downloads (licensed third-party audio stays out of git)
jamendo-candidates.json
*.mp3
*.ogg
*.flac
